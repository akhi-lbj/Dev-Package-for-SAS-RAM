# ==============================================================================
# SAS Retrieval Agent Manager (RAM) Environment Configuration
# ==============================================================================

# Base URL for your SAS Retrieval Agent Manager instance (without trailing slash)
# Example: https://ram-server.example.com
RAM_URL=https://<your-sas-ram-host>

# Optional URL prefix when hosted under a subpath (e.g., /ChatExtension).
# Leave blank if the app is served at domain root.
NEXT_PUBLIC_BASE_PATH=
